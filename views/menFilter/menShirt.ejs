<style>
  .filter-sidebar {
      position: fixed;
      top: 0;
      right: 0;
      height: 100vh;
      width: 300px;
      background-color: #f8f9fa;
      padding: 20px;
      box-shadow: -2px 0 5px rgba(0,0,0,0.1);
      transform: translateX(100%);
      transition: transform 0.3s ease-in-out;
      overflow-y: auto;
      z-index: 1050;
  }
  .filter-sidebar.active {
      transform: translateX(0);
  }
  .listing-card img {
      height: 35rem;
      object-fit: cover;
  }
</style>
<div>
    <button id="openFilterBtn" class="btn btn-primary">Open Filters</button>
    
    <div class="filter-sidebar" id="filterSidebar">
      <h4>Filter Options</h4>
      <button id="closeFilterBtn" class="btn btn-danger mb-3">Close</button>
  
      <form method="GET" action="/StyleZen/men/shirt/filter" id="filterForm">
        
        <!-- Color Filter -->
        <div>
          <input type="checkbox" id="colorFilter">
          <label for="colorFilter">Color</label>
        </div>
        <div id="colorOptions" style="display: none; padding-left: 20px;">
            <div>
              <input type="checkbox" name="colors" id="White" value="White"> 
              <label for="White">White</label>
            </div>
            <div>
              <input type="checkbox" name="colors" id="Blue" value="Blue">
              <label for="Blue">Blue</label>
            </div>
            <div>
              <input type="checkbox" name="colors" id="Black" value="Black"> 
              <label for="Black">Black</label>
            </div>
            <div>
              <input type="checkbox" name="colors" id="Grey" value="Grey"> 
              <label for="Grey">Grey</label>
            </div>
            <div>
              <input type="checkbox" name="colors" id="Pink" value="Pink"> 
              <label for="Pink">Pink</label>
            </div>
            <div>
              <input type="checkbox" name="colors" id="Green" value="Green"> 
              <label for="Green">Green</label>
            </div>
        </div>
  
        <!-- Style Filter -->
        <div>
          <input type="checkbox" id="styleFilter">
          <label for="styleFilter">Style</label>
        </div>
        <div id="styleOptions" style="display: none; padding-left: 20px;">
          <div>
            <input type="checkbox" name="style" id="Formal" value="Formal"> 
            <label for="Formal">Formal</label>
          </div>
          <div>
            <input type="checkbox" name="style" id="Casual" value="Casual">
            <label for="Casual">Casual</label>
          </div>
          <div>
            <input type="checkbox" name="style" id="Slim Fit" value="Slim Fit"> 
            <label for="Slim Fit">Slim Fit</label>
          </div>
          <div>
            <input type="checkbox" name="style" id="Regular Fit" value="Regular Fit"> 
            <label for="Regular Fit">Regular Fit</label>
          </div>
        </div>

        <!-- Size Filter -->
        <div>
          <input type="checkbox" id="sizeFilter">
          <label for="sizeFilter">Size</label>
        </div>
        <div id="sizeOptions" style="display: none; padding-left: 20px;">
          <div>
            <input type="checkbox" name="size" id="S" value="S"> 
            <label for="S">S</label>
          </div>
          <div>
            <input type="checkbox" name="size" id="M" value="M">
            <label for="M">M</label>
          </div>
          <div>
            <input type="checkbox" name="size" id="L" value="L"> 
            <label for="L">L</label>
          </div>
          <div>
            <input type="checkbox" name="size" id="XL" value="XL"> 
            <label for="XL">XL</label>
          </div>
          <div>
            <input type="checkbox" name="size" id="XXL" value="XXL"> 
            <label for="XXL">XXL</label>
          </div>
        </div>

        <!-- Brand Filter -->
        <div>
          <input type="checkbox" id="brandFilter">
          <label for="brandFilter">Brand</label>
        </div>
        <div id="brandOptions" style="display: none; padding-left: 20px;">
          <div>
            <input type="checkbox" name="brand" id="Van Heusen" value="Van Heusen"> 
            <label for="Van Heusen">Van Heusen</label>
          </div>
          <div>
            <input type="checkbox" name="brand" id="Arrow" value="Arrow">
            <label for="Arrow">Arrow</label>
          </div>
          <div>
            <input type="checkbox" name="brand" id="Peter England" value="Peter England"> 
            <label for="Peter England">Peter England</label>
          </div>
          <div>
            <input type="checkbox" name="brand" id="Louis Philippe" value="Louis Philippe"> 
            <label for="Louis Philippe">Louis Philippe</label>
          </div>
          <div>
            <input type="checkbox" name="brand" id="Zara" value="Zara"> 
            <label for="Zara">Zara</label>
          </div>
        </div>

        <!-- Price Range Filter -->
        <div>
          <input type="checkbox" id="priceFilter">
          <label for="priceFilter">Price Range</label>
        </div>
        <div id="priceOptions" style="display: none; padding-left: 20px;">
          <div>
            <input type="checkbox" name="priceRange" value="1000-2000" id="1000-2000">
            <label for="1000-2000">₹1000 - ₹2000</label>
          </div>
          <div>
            <input type="checkbox" name="priceRange" value="2000-3000" id="2000-3000">
            <label for="2000-3000">₹2000 - ₹3000</label>
          </div>
          <div>
            <input type="checkbox" name="priceRange" value="3000-4000" id="3000-4000">
            <label for="3000-4000">₹3000 - ₹4000</label>
          </div>
          <div>
            <input type="checkbox" name="priceRange" value="4000-5000" id="4000-5000">
            <label for="4000-5000">₹4000 - ₹5000</label>
          </div>
        </div>

        <!-- Delivery Time Filter -->
        <div>
          <input type="checkbox" id="deliveryFilter">
          <label for="deliveryFilter">Delivery Time</label>
        </div>
        <div id="deliveryOptions" style="display: none; padding-left: 20px;">
          <div>
            <input type="checkbox" name="deliveryTime" value="Tomorrow" id="tomorrow">
            <label for="tomorrow">Tomorrow</label>
          </div>
          <div>
            <input type="checkbox" name="deliveryTime" value="2-3 Days" id="2-3">
            <label for="2-3">2-3 Days</label>
          </div>
          <div>
            <input type="checkbox" name="deliveryTime" value="3-5 Days" id="3-5">
            <label for="3-5">3-5 Days</label>
          </div>
        </div>

        <button type="submit" class="btn btn-primary">Apply Filter</button>
      </form>
  </div>
  <script>
    // Toggle Sidebar
    document.getElementById('openFilterBtn').addEventListener('click', () => {
        document.getElementById('filterSidebar').classList.add('active');
    });
  
    document.getElementById('closeFilterBtn').addEventListener('click', () => {
        document.getElementById('filterSidebar').classList.remove('active');
    });
  
    // Show/Hide Color Options
    document.getElementById("colorFilter").addEventListener("click", function () {
        let colorOptions = document.getElementById("colorOptions");
        colorOptions.style.display = colorOptions.style.display === "none" ? "block" : "none";
    });
  
    // Show/Hide Style Options
    document.getElementById('styleFilter').addEventListener('click', function() {
      document.getElementById('styleOptions').style.display = this.checked ? 'block' : 'none';
    });
  
    // Show/Hide Size Options
    document.getElementById('sizeFilter').addEventListener('click', function() {
      document.getElementById('sizeOptions').style.display = this.checked ? 'block' : 'none';
    });

    // Show/Hide Brand Options
    document.getElementById('brandFilter').addEventListener('click', function() {
      document.getElementById('brandOptions').style.display = this.checked ? 'block' : 'none';
    });

    // Show/Hide Price Options
    document.getElementById('priceFilter').addEventListener('click', function() {
      document.getElementById('priceOptions').style.display = this.checked ? 'block' : 'none';
    });

    // Show/Hide Delivery Options
    document.getElementById('deliveryFilter').addEventListener('click', function() {
      document.getElementById('deliveryOptions').style.display = this.checked ? 'block' : 'none';
    });
  </script>
</div> 
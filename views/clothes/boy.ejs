<%- include("../includes/navbar.ejs") %>


<style>
  /* Adjusting card image heights */
  .card-img-top {
    height: 200px;
    object-fit: cover;
  }

  /* Ensuring all cards have equal height */
  .equal-height-img {
    height: 100%;
    object-fit: cover;
  }

  /* Adjust the heading size and alignment */
  h2 {
    text-align: center;
    margin-top: 20px;
    font-size: 2rem; /* Adjust font size */
    font-weight: 600;
  }

  /* Ensure the left navigation takes up 100% height */
  .left-nav {
    height: 100vh; /* Makes the nav stretch full height */
    border-right: 1px solid #ddd; /* Adds a border between nav and content */
    padding: 0;
  }

  /* Card body adjustments */
  .card-body {
    padding: 1rem; /* Adjust padding inside cards */
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: bold;
  }

  .card-text a {
    text-decoration: none;
    color: #007bff;
  }

  .card-text a:hover {
    text-decoration: underline;
  }

  /* Ensuring the card containers align properly */
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
  }

  /* Ensuring cards take the full height if needed */
  .col-md-3, .col-md-6 {
    display: flex;
    flex-direction: column;
  }

  .card {
    flex-grow: 1;
  }
</style>


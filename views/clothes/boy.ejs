          <li class="nav-item"><a class="nav-link" href="/StyleZen/boy/jacket">Jacket</a></li>
          <li class="nav-item"><a class="nav-link" href="/StyleZen/boy/activewear">ActiveWear</a></li>
          <li class="nav-item"><a class="nav-link" href="/StyleZen/boy/watch">Watch</a></li>
          <li class="nav-item"><a class="nav-link" href="/StyleZen/boy/kurti">Kurti</a></li>

          <li class="nav-item"><a class="nav-link" href="/StyleZen/boy/jean">Jeans</a></li>
          <li class="nav-item"><a class="nav-link" href="/StyleZen/boy/tee">Tee</a></li>
          <li class="nav-item"><a class="nav-link" href="/StyleZen/boy/shirt">Shirt</a></li>
          <li class="nav-item"><a class="nav-link" href="/StyleZen/boy/jacket">Jacket</a></li>
          <li class="nav-item"><a class="nav-link" href="/StyleZen/boy/activewear">ActiveWear</a></li>
          <li class="nav-item"><a class="nav-link" href="/StyleZen/boy/watch">Watch</a></li>
          <li class="nav-item"><a class="nav-link" href="/StyleZen/boy/kurti">Kurti</a></li>
          <li class="nav-item"><a class="nav-link" href="/StyleZen/boy/cap">Cap</a></li>
          <li class="nav-item"><a class="nav-link" href="/StyleZen/boy/footwear">FootWear</a></li>
          <li class="nav-item"><a class="nav-link" href="/StyleZen/boy/accessory">Accessory</a></li>
          <li class="nav-item"><a class="nav-link" href="/StyleZen/boy/bag">Bags</a></li>
        </ul>
      </div>

      <!-- Center Column for Content -->
      <div class="col-md-10">
        <div class="container mt-4">
          <div class="row">
            <!-- Shirt Card (Smaller width) -->
            <div class="col-md-4 mb-4">
              <div class="card border-0">
                <img src="https://i.pinimg.com/736x/b3/db/4e/b3db4e59ffa8143c1ceb26520ab04f68.jpg" 
                     class="card-img-top equal-height-img" alt="Shirt">
                <div class="card-body text-center">
                  <h5 class="card-title"><b>Shirt</b></h5>
                  <p class="card-text"><a href="/StyleZen/boy/Shirt">SHOP NOW</a></p>
                </div>
              </div>
            </div> 
         
            <!-- Kurti Card (Wider) -->
            <div class="col-md-4 mb-4">
              <div class="card border-0">
                <img src="https://i.pinimg.com/736x/da/39/a0/da39a0a9db50438fee39395c44bb9a90.jpg" 
                     class="card-img-top equal-height-img" alt="Cap">
                <div class="card-body text-center">
                  <h5 class="card-title"><b>Cap</b></h5>
                  <p class="card-text"><a href="/StyleZen/boy/Cap">SHOP NOW</a></p>
                </div>
              </div>
            </div>
        
            <!-- Bag Card (Smaller width) -->
            <div class="col-md-4 mb-4">
              <div class="card border-0">
                <img src="https://i.pinimg.com/736x/02/13/dc/0213dc65e7d565a04da0c9849032333a.jpg" 
                     class="card-img-top equal-height-img" alt="shoes">
                <div class="card-body text-center">
                  <h5 class="card-title"><b>Footwear</b></h5>
                  <p class="card-text"><a href="/StyleZen/boy/shoes">SHOP NOW</a></p>

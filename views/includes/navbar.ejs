<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>StyleZen</title>
  <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm fixed-top">
    <div class="container-fluid"> <!-- Full Width Navbar -->
  
      <!-- Logo -->
      <a class="navbar-brand fs-4" href="/StyleZen"><b><i>StyleZen</i></b></a>
  
      <!-- Mobile Toggle Button -->
      <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
  
      <!-- Navbar Links -->
      <div class="collapse navbar-collapse justify-content-center" id="navbarNav">
          
        <div class="collapse navbar-collapse justify-content-center" id="navbarNav1">
          <div class="d-flex justify-content-center w-100">
              <ul class="navbar-nav">
                  <li class="nav-item"><a class="nav-link" href="/StyleZen/women">WOMEN</a></li>
                  <li class="nav-item"><a class="nav-link" href="/StyleZen/men">MEN</a></li>
                  <li class="nav-item"><a class="nav-link" href="/StyleZen/girl">GIRLS</a></li>
                  <li class="nav-item"><a class="nav-link" href="/StyleZen/boy">BOYS</a></li>
              </ul>
          </div>
      </div>
  
        <!-- Right Side (Auth, Search, Cart) -->
        <ul class="navbar-nav ml-auto d-flex align-items-center">
          <% if (!currentUser) { %>
            <li class="nav-item"><a class="nav-link login" href="/StyleZen/signup"><b>Signup</b></a></li>
            <li class="nav-item"><a class="nav-link login" href="/StyleZen/login"><b>Login</b></a></li>
          <% } %>
  
          <% if (currentUser) { %>
            <li class="nav-item"><a class="nav-link login" href="/StyleZen/logout"><b>Logout</b></a></li>
          <% } %>  
  
          <!-- Search Bar -->
          <li class="nav-item">
            <form action="/search" method="GET" class="d-flex ml-3">
              <input type="text" name="q" class="form-control" placeholder="Search">
              <button type="submit" class="btn btn-outline-success ml-2">Search</button>
            </form>
          </li>

  
          <!-- Cart Icon -->
          <li class="nav-item ml-3">
            <a href="/StyleZen/cart" class="nav-link cart-icon">
              <i class="fas fa-shopping-cart"></i>
            </a>
          </li>
  
          <!-- Wishlist Icon -->
          <li class="nav-item ml-2">
            <a href="/StyleZen/wishlist" class="nav-link heart-icon ">
              <i class="fas fa-heart text-grey"></i>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </nav>
  
</body>
</html>
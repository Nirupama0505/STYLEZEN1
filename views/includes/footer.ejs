<!DOCTYPE html>
<html lang="en" class="h-100">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StyleZen</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        /* Ensures the footer stays at the bottom */
        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        main {
            flex: 1;
        }
        footer {
            background-color: #AB886D; /* Dark Background */
            color: #493628; /* Light Beige Text */
        }
        footer a {
            color: #493628; /* Matching link color */
            text-decoration: none;
        }
        footer a:hover {
            color: white; /* Hover effect */
        }
    </style>
</head>

<body class="d-flex flex-column min-vh-100">

    <main class="flex-grow-1">
        <!-- Your main page content here -->
    </main>

    <!-- Sticky Footer -->
    <footer class="py-5 mt-auto">
        <div class="container-fluid">
            <div class="row text-md-start text-center">
                <!-- Company Info -->
                <div class="col-md-3 mb-4">
                    <h5>Elan Accessories</h5>
                    <p>123 Fashion Street, New York, NY<br>Email: info@elanaccessories.com<br>Phone: (123) 456-7890</p>
                </div>

                <!-- Quick Links -->
                <div class="col-md-3 mb-4">
                    <h5>Quick Links</h5>
                    <ul class="list-unstyled">
                        <li><a href="#">About Us</a></li>
                        <li><a href="#">Shop</a></li>
                        <li><a href="#">Contact</a></li>
                        <li><a href="#">Privacy Policy</a></li>
                    </ul>
                </div>

                <!-- Social Media -->
                <div class="col-md-3 mb-4">
                    <h5>Follow Us</h5><br>
                    <div class="d-flex gap-3">
                        <a href="#"><i class="fab fa-facebook fa-lg"></i></a>
                        <a href="#"><i class="fab fa-instagram fa-lg"></i></a>
                        <a href="#"><i class="fab fa-twitter fa-lg"></i></a>
                        <a href="#"><i class="fab fa-linkedin fa-lg"></i></a>
                    </div>
                </div>

                <!-- Orders -->
                <div class="col-md-3 mb-4">
                    <h5> Orders</h5>
                    
                        <div class="mb-3">
                            <a href="#">About Orders</a><br>
                        <a href="#">About Returns Policy</a><br>
                        <a href="#">About Exchange Policy</a><br>
                        <a href="#">About Sales</a>
                        </div>
                        
                </div>
            </div>

            <!-- Footer Bottom -->
            <div class="text-center mt-4">
                <p class="mb-0">&copy; 2025 StyleZen . All rights reserved.</p>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.2/dist/umd/popper.min.js"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

</body>
</html>

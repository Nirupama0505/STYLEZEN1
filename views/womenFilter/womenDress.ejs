<style>
  .filter-sidebar {
      position: fixed;
      top: 0;
      right: 0;
      height: 100vh;
      width: 300px;
      background-color: #f8f9fa;
      padding: 20px;
      box-shadow: -2px 0 5px rgba(0,0,0,0.1);
      transform: translateX(100%);
      transition: transform 0.3s ease-in-out;
      overflow-y: auto;
      z-index: 1050;
  }
  .filter-sidebar.active {
      transform: translateX(0);
  }
  .listing-card img {
      height: 35rem;
      object-fit: cover;
  }
</style>
<div>
    <button id="openFilterBtn" class="btn btn-primary">Open Filters</button>
    
    <div class="filter-sidebar" id="filterSidebar">
      <h4>Filter Options</h4>
      <button id="closeFilterBtn" class="btn btn-danger mb-3">Close</button>
  
      <form method="GET" action="/StyleZen/women/dress/filter" id="filterForm">
        
        <!-- Color Filter -->
        <div>
          <input type="checkbox" id="colorFilter">
          <label for="colorFilter">Color</label>
        </div>
        <div id="colorOptions" style="display: none; padding-left: 20px;">
            <div>
              <input type="checkbox" name="colors" id="Black" value="Black"> 
              <label for="Black">Black</label>
            </div>
            <div>
              <input type="checkbox" name="colors" id="Blue" value="Blue">
              <label for="Blue">Blue</label>
            </div>
            <div>
              <input type="checkbox" name="colors" id="Red" value="Red"> 
              <label for="Red">Red</label>
            </div>
            <div>
              <input type="checkbox" name="colors" id="White" value="White"> 
              <label for="White">White</label>
            </div>
            <div>
              <input type="checkbox" name="colors" id="Green" value="Green"> 
              <label for="Green">Green</label>
            </div>
        </div>
  
        <!-- Style Filter -->
        <div>
          <input type="checkbox" id="styleFilter">
          <label for="styleFilter">Style</label>
        </div>
        <div id="styleOptions" style="display: none; padding-left: 20px;">
          <div>
            <input type="checkbox" name="style" id="Casual" value="Casual"> 
            <label for="Casual">Casual</label>
          </div>
          <div>
            <input type="checkbox" name="style" id="Formal" value="Formal">
            <label for="Formal">Formal</label>
          </div>
          <div>
            <input type="checkbox" name="style" id="Party" value="Party"> 
            <label for="Party">Party</label>
          </div>
          <div>
            <input type="checkbox" name="style" id="Ethnic" value="Ethnic"> 
            <label for="Ethnic">Ethnic</label>
          </div>
        </div>

        <!-- Length Filter -->
        <div>
          <input type="checkbox" id="lengthFilter">
          <label for="lengthFilter">Length</label>
        </div>
        <div id="lengthOptions" style="display: none; padding-left: 20px;">
          <div>
            <input type="checkbox" name="length" id="Mini" value="Mini"> 
            <label for="Mini">Mini</label>
          </div>
          <div>
            <input type="checkbox" name="length" id="Midi" value="Midi">
            <label for="Midi">Midi</label>
          </div>
          <div>
            <input type="checkbox" name="length" id="Maxi" value="Maxi"> 
            <label for="Maxi">Maxi</label>
          </div>
        </div>

        <!-- Neckline Filter -->
        <div>
          <input type="checkbox" id="necklineFilter">
          <label for="necklineFilter">Neckline</label>
        </div>
        <div id="necklineOptions" style="display: none; padding-left: 20px;">
          <div>
            <input type="checkbox" name="neckline" id="Round" value="Round"> 
            <label for="Round">Round</label>
          </div>
          <div>
            <input type="checkbox" name="neckline" id="V-neck" value="V-neck">
            <label for="V-neck">V-neck</label>
          </div>
          <div>
            <input type="checkbox" name="neckline" id="Square" value="Square"> 
            <label for="Square">Square</label>
          </div>
          <div>
            <input type="checkbox" name="neckline" id="Off-shoulder" value="Off-shoulder"> 
            <label for="Off-shoulder">Off-shoulder</label>
          </div>
        </div>

        <!-- Sleeve Length Filter -->
        <div>
          <input type="checkbox" id="sleeveFilter">
          <label for="sleeveFilter">Sleeve Length</label>
        </div>
        <div id="sleeveOptions" style="display: none; padding-left: 20px;">
          <div>
            <input type="checkbox" name="sleeve" id="Sleeveless" value="Sleeveless"> 
            <label for="Sleeveless">Sleeveless</label>
          </div>
          <div>
            <input type="checkbox" name="sleeve" id="Short" value="Short">
            <label for="Short">Short</label>
          </div>
          <div>
            <input type="checkbox" name="sleeve" id="Three-quarter" value="Three-quarter"> 
            <label for="Three-quarter">Three-quarter</label>
          </div>
          <div>
            <input type="checkbox" name="sleeve" id="Full" value="Full"> 
            <label for="Full">Full</label>
          </div>
        </div>

        <!-- Pattern Filter -->
        <div>
          <input type="checkbox" id="patternFilter">
          <label for="patternFilter">Pattern</label>
        </div>
        <div id="patternOptions" style="display: none; padding-left: 20px;">
          <div>
            <input type="checkbox" name="pattern" id="Solid" value="Solid"> 
            <label for="Solid">Solid</label>
          </div>
          <div>
            <input type="checkbox" name="pattern" id="Printed" value="Printed">
            <label for="Printed">Printed</label>
          </div>
          <div>
            <input type="checkbox" name="pattern" id="Floral" value="Floral"> 
            <label for="Floral">Floral</label>
          </div>
          <div>
            <input type="checkbox" name="pattern" id="Striped" value="Striped"> 
            <label for="Striped">Striped</label>
          </div>
        </div>

        <!-- Fabric Filter -->
        <div>
          <input type="checkbox" id="fabricFilter">
          <label for="fabricFilter">Fabric</label>
        </div>
        <div id="fabricOptions" style="display: none; padding-left: 20px;">
          <div>
            <input type="checkbox" name="fabric" id="Cotton" value="Cotton"> 
            <label for="Cotton">Cotton</label>
          </div>
          <div>
            <input type="checkbox" name="fabric" id="Silk" value="Silk">
            <label for="Silk">Silk</label>
          </div>
          <div>
            <input type="checkbox" name="fabric" id="Chiffon" value="Chiffon"> 
            <label for="Chiffon">Chiffon</label>
          </div>
          <div>
            <input type="checkbox" name="fabric" id="Georgette" value="Georgette"> 
            <label for="Georgette">Georgette</label>
          </div>
        </div>

        <!-- Price Range Filter -->
        <div>
          <input type="checkbox" id="priceFilter">
          <label for="priceFilter">Price Range</label>
        </div>
        <div id="priceOptions" style="display: none; padding-left: 20px;">
          <div>
            <input type="checkbox" name="priceRange" value="500-1000" id="500-1000">
            <label for="500-1000">₹500 - ₹1000</label>
          </div>
          <div>
            <input type="checkbox" name="priceRange" value="1000-1500" id="1000-1500">
            <label for="1000-1500">₹1000 - ₹1500</label>
          </div>
          <div>
            <input type="checkbox" name="priceRange" value="1500-2000" id="1500-2000">
            <label for="1500-2000">₹1500 - ₹2000</label>
          </div>
          <div>
            <input type="checkbox" name="priceRange" value="2000-2500" id="2000-2500">
            <label for="2000-2500">₹2000 - ₹2500</label>
          </div>
        </div>

        <!-- Delivery Time Filter -->
        <div>
          <input type="checkbox" id="deliveryFilter">
          <label for="deliveryFilter">Delivery Time</label>
        </div>
        <div id="deliveryOptions" style="display: none; padding-left: 20px;">
          <div>
            <input type="checkbox" name="deliveryTime" value="Tomorrow" id="tomorrow">
            <label for="tomorrow">Tomorrow</label>
          </div>
          <div>
            <input type="checkbox" name="deliveryTime" value="2-3 Days" id="2-3">
            <label for="2-3">2-3 Days</label>
          </div>
          <div>
            <input type="checkbox" name="deliveryTime" value="3-5 Days" id="3-5">
            <label for="3-5">3-5 Days</label>
          </div>
          <div>
            <input type="checkbox" name="deliveryTime" value="2-5 Days" id="2-5">
            <label for="2-5">2-5 Days</label>
          </div>
        </div>

        <button type="submit" class="btn btn-primary">Apply Filter</button>
      </form>
  </div>
  <script>
    // Toggle Sidebar
    document.getElementById('openFilterBtn').addEventListener('click', () => {
        document.getElementById('filterSidebar').classList.add('active');
    });
  
    document.getElementById('closeFilterBtn').addEventListener('click', () => {
        document.getElementById('filterSidebar').classList.remove('active');
    });
  
    // Show/Hide Color Options
    document.getElementById("colorFilter").addEventListener("click", function () {
        let colorOptions = document.getElementById("colorOptions");
        colorOptions.style.display = colorOptions.style.display === "none" ? "block" : "none";
    });
  
    // Show/Hide Style Options
    document.getElementById('styleFilter').addEventListener('click', function() {
      document.getElementById('styleOptions').style.display = this.checked ? 'block' : 'none';
    });
  
    // Show/Hide Length Options
    document.getElementById('lengthFilter').addEventListener('click', function() {
      document.getElementById('lengthOptions').style.display = this.checked ? 'block' : 'none';
    });

    // Show/Hide Neckline Options
    document.getElementById('necklineFilter').addEventListener('click', function() {
      document.getElementById('necklineOptions').style.display = this.checked ? 'block' : 'none';
    });

    // Show/Hide Sleeve Options
    document.getElementById('sleeveFilter').addEventListener('click', function() {
      document.getElementById('sleeveOptions').style.display = this.checked ? 'block' : 'none';
    });

    // Show/Hide Pattern Options
    document.getElementById('patternFilter').addEventListener('click', function() {
      document.getElementById('patternOptions').style.display = this.checked ? 'block' : 'none';
    });

    // Show/Hide Fabric Options
    document.getElementById('fabricFilter').addEventListener('click', function() {
      document.getElementById('fabricOptions').style.display = this.checked ? 'block' : 'none';
    });

    // Show/Hide Price Options
    document.getElementById('priceFilter').addEventListener('click', function() {
      document.getElementById('priceOptions').style.display = this.checked ? 'block' : 'none';
    });

    // Show/Hide Delivery Options
    document.getElementById('deliveryFilter').addEventListener('click', function() {
      document.getElementById('deliveryOptions').style.display = this.checked ? 'block' : 'none';
    });

    // Prevent Form Submission with No Selection
    document.getElementById("filterForm").addEventListener("submit", function(e) {
      const checkboxes = document.querySelectorAll("#colorOptions input[type='checkbox']:checked");
      // if (checkboxes.length === 0) {
      //   e.preventDefault();
      //   alert("Please select at least one color.");
      // }
    });
  </script> 
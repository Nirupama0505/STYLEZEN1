<%- include("../includes/navbar.ejs") %>
<%- include("../includes/flash.ejs") %>
<div class="container mt-5 mb-5">  <!-- Added mt-5 and mb-5 -->
  <div class="row">
    <div class="col-6 offset-3">
      <form method="POST" action="/StyleZen/signup" novalidate class="needs-validation">
        <div class="col-8 offset-3">
          <h4>Signup on StyleZen</h4>
          <p>Create an account to save your wishlist and purchase information.</p>
        </div>
        <div>
          <label for="username" class="form-label">Username</label>
          <input placeholder="enter username" name="username"
           type="text" class="form-control" id="username" required>
          <div class="valid-feedback">Username good!</div>
        </div>
        <br>
        <div class="mb-3">
          <label for="email" class="form-label">Email</label>
          <input placeholder="enter email" name="email"
           type="email" class="form-control" id="email" required> 
        </div>
        <div class="mb-3">
          <label for="password" class="form-label">Password</label>
          <input placeholder="enter password" name="password"
           type="password" class="form-control" id="password" required> 
        </div>
        <button class="btn btn-success">Submit</button>
      </form>
    </div>
  </div>
</div>

    <%- include("../includes/footer.ejs") %>